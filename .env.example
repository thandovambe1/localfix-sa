# Database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Yoco payments (live keys go in Vercel env vars / local .env — never in source code)
YOCO_SECRET_KEY=
NEXT_PUBLIC_YOCO_PUBLIC_KEY=
YOCO_WEBHOOK_SECRET=
NEXT_PUBLIC_BASE_URL=

# Admin profiles created by POST /api/admin/setup when admin_users is empty
FOUNDER_EMAIL=founder@localfix.co.za
FOUNDER_PASSWORD=
ADMIN_EMAIL=admin@localfix.co.za
ADMIN_PASSWORD=
FINANCE_EMAIL=finance@localfix.co.za
FINANCE_PASSWORD=

# Session signing secret (generate a strong random value for production)
ADMIN_SESSION_SECRET=

# Optional: required to re-run /api/admin/setup after any admin already exists
ADMIN_SETUP_TOKEN=

# SMTP mailer for all LocalFix SA communications
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="LocalFix SA <no-reply@localfix.co.za>"

# Optional secret protecting the automatic email retry cron endpoint
CRON_SECRET=

