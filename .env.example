# Database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Yoco payments
YOCO_SECRET_KEY=
YOCO_WEBHOOK_SECRET=
NEXT_PUBLIC_BASE_URL=

# Admin profiles created by POST /api/admin/setup when admin_users is empty
FOUNDER_EMAIL=founder@localfix.co.za
FOUNDER_PASSWORD=
ADMIN_EMAIL=admin@localfix.co.za
ADMIN_PASSWORD=
FINANCE_EMAIL=finance@localfix.co.za
FINANCE_PASSWORD=

# Session signing secret (generate a strong random value for production)
ADMIN_SESSION_SECRET=

# Optional: required to re-run /api/admin/setup after any admin already exists
ADMIN_SETUP_TOKEN=

# SMTP mailer for founder verification-code emails
SMTP_HOST=mail.localfix.co.za
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@localfix.co.za
SMTP_PASSWORD=LocalFix@2026!
SMTP_FROM="LocalFix SA <no-reply@localfix.co.za>"
